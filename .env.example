PUBLIC_BASEMAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
PUBLIC_BASEMAP_ATTRIBUTION=© OpenStreetMap contributors

# Server-only OpenStreetMap extract used by nearby parks and nearby water.
# OSM_PBF_PATH=georgia-latest.osm.pbf
# The derived index defaults to .cache/osm/ and is rebuilt when the PBF changes.
# OSM_INDEX_PATH=.cache/osm/georgia.places-heatmap.json

# Enables driving-time filter regions and heatmaps and supplies the first
# address lookup source.
ORS_API_KEY=

# `npm run setup:https` creates the default files under .certs/.
# Astro config reads these optional overrides from the shell when running
# `npm run dev:https`.
# LOCAL_HTTPS_HOST=10.0.0.247
# LOCAL_HTTPS_CERT=.certs/places-heatmap.pem
# LOCAL_HTTPS_KEY=.certs/places-heatmap-key.pem
